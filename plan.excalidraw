    {
      "id": "k-_N_Nq0QWaHnclU8k_7A",
      "type": "text",
      "x": 951.484375,
      "y": 846.73046875,
      "width": 162.90234375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aW",
      "roundness": null,
      "seed": 1168647223,
      "version": 78,
      "versionNonce": 1258607415,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794759311288,
      "link": null,
      "locked": false,
      "text": "как отрезать\nименно нужный\nфайл ?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "как отрезать именно нужный файл ?",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "ZLSYezor40pAlcJy0SBVN",
      "type": "text",
      "x": -195.880859375,
      "y": -286.71875,
      "width": 326.65234375,
      "height": 575,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aX",
      "roundness": null,
      "seed": 415594539,
      "version": 540,
      "versionNonce": 818650587,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795711188773,
      "link": null,
      "locked": false,
      "text": "отрендереная сцена без слоев\n слои обычно идут в разрешении\nоблоев то есть что бы получить\nконструктор обоев нужно просто\nналожить их на отрендереную\nсцену и записать видео заного \n то есть \n\nесли там есть видео слои\nрендерим сцену в конце\nспрашиваем не хочет ли\nпользователь  отрендерить фон\nсо слоями  если да то мы берем\nвыходной файл отрендереный и\nнакладываемм слой если слоев\nмного то на выход след слой  \n\nffmpeg -i background.mp4 -i\neffect.mp4 -filter_complex \"[0:v]\n[1:v]blend=all_mode=screen\" -c:v\nlibx264 -crf 18 -pix_fmt yuv420p\noutput.mp4\n ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "отрендереная сцена без слоев\n слои обычно идут в разрешении облоев то есть что бы получить конструктор обоев нужно просто наложить их на отрендереную сцену и записать видео заного \n то есть \n\nесли там есть видео слои рендерим сцену в конце спрашиваем не хочет ли пользователь  отрендерить фон со слоями  если да то мы берем выходной файл отрендереный и  накладываемм слой если слоев много то на выход след слой  \n\nffmpeg -i background.mp4 -i effect.mp4 -filter_complex \"[0:v][1:v]blend=all_mode=screen\" -c:v libx264 -crf 18 -pix_fmt yuv420p output.mp4\n ",
      "autoResize": false,
      "lineHeight": 1.25
    }
  ],
